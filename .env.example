# DeskOps Phase 1 Environment Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL + Prisma)
DATABASE_URL=postgresql://deskops:deskops_secret@localhost:5432/deskops_db?schema=public

# Redis (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=deskops-super-secure-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=deskops-super-secure-refresh-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Business Rules
REOPEN_WINDOW_DAYS=7
MAX_ATTACHMENT_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# Object Storage (S3 / R2 compatible)
S3_BUCKET=deskops-attachments
S3_REGION=auto
S3_ENDPOINT=https://storage.example.com
S3_ACCESS_KEY=mock_access_key
S3_SECRET_KEY=mock_secret_key

# Webhooks
INBOUND_EMAIL_WEBHOOK_SECRET=deskops-email-webhook-secret-2026

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
